<% if (draft.status === "pending_stro_review") { %>

  <div class="section">
    <div class="section-title">
      STRO Review Decision
    </div>

    <div class="section-body">

      <form
        action="/stro/drafts/<%= draft.str_id %>/review"
        method="POST"
      >

        <div class="mb-3">
          <label
            for="stroFeedback"
            class="form-label fw-bold"
          >
            Feedback to Analyst
          </label>

          <textarea
            id="stroFeedback"
            name="stro_feedback"
            class="form-control"
            rows="5"
            placeholder="Enter amendments, missing information, or clarification required from the analyst"
          ></textarea>

          <div class="form-text">
            Feedback is required when returning the draft to the analyst.
          </div>
        </div>

        <div class="d-flex justify-content-end gap-2">

          <a
            href="/stro/dashboard"
            class="btn btn-outline-secondary"
          >
            Back
          </a>

          <button
            type="submit"
            name="decision"
            value="send_feedback"
            class="btn btn-warning"
            onclick="return validateFeedback();"
          >
            Send Feedback to Analyst
          </button>

          <button
            type="submit"
            name="decision"
            value="approve"
            class="btn btn-success"
            onclick="return confirm(
              'Approve this STR draft?'
            );"
          >
            Approve Draft
          </button>

        </div>

      </form>

    </div>
  </div>

<% } %>

<script>
  function validateFeedback() {
    const feedback = document
      .getElementById("stroFeedback")
      .value
      .trim();

    if (!feedback) {
      alert(
        "Please enter feedback before returning the STR draft to the analyst."
      );

      return false;
    }

    return confirm(
      "Send this feedback back to the analyst?"
    );
  }
</script>

<% if (draft.status === "feedback_required") { %>

  <div class="alert alert-warning">
    <h5>Feedback Sent to Analyst</h5>

    <p class="mb-0">
      <strong>Feedback:</strong>
      <%= draft.stro_feedback || "No feedback provided." %>
    </p>
  </div>

<% } %>

<% if (draft.status === "approved_by_stro") { %>

  <div class="alert alert-success">
    <h5>STR Draft Approved</h5>

    <p class="mb-0">
      This STR draft has been approved by the STRO reviewer.
    </p>
  </div>

<% } %>