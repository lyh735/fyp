<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>STRO Review Dashboard</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <style>
    body {
      background: #f4f6f8;
      font-family: Arial, Helvetica, sans-serif;
    }

    .navbar-custom {
      background: #172337;
    }

    .page-container {
      max-width: 1250px;
      margin: 30px auto;
    }

    .header-card,
    .table-card {
      background: white;
      border-radius: 10px;
      box-shadow: 0 3px 14px rgba(0, 0, 0, 0.07);
    }

    .header-card {
      padding: 25px;
      margin-bottom: 22px;
    }

    .table-card {
      overflow: hidden;
    }

    .status-pending {
      background: #fff3cd;
      color: #664d03;
    }

    .status-accepted {
      background: #d1e7dd;
      color: #0f5132;
    }

    .status-rejected {
      background: #f8d7da;
      color: #842029;
    }
  </style>
</head>

<body>

<nav class="navbar navbar-dark navbar-custom">
  <div class="container-fluid px-4">
    <span class="navbar-brand">
      Simulated STRO Review Portal
    </span>

    <span class="text-white">
      <%= user?.name || user?.username || "STRO Reviewer" %>
    </span>
  </div>
</nav>

<div class="page-container">

  <div class="header-card">
    <h2>Submitted STR Drafts</h2>

    <p class="text-muted mb-0">
      Review STR drafts submitted by Compliance Officers.
    </p>
  </div>

  <div class="table-card">
    <div class="table-responsive">

      <table class="table table-hover align-middle mb-0">

        <thead class="table-dark">
          <tr>
            <th>STR Reference</th>
            <th>Transaction</th>
            <th>Merchant</th>
            <th>Amount</th>
            <th>Risk</th>
            <th>Status</th>
            <th>Action</th>
          </tr>
        </thead>

        <tbody>

          <% if (!drafts || drafts.length === 0) { %>
            <tr>
              <td colspan="7" class="text-center py-5 text-muted">
                No STR drafts have been submitted to STRO.
              </td>
            </tr>
          <% } %>

          <% drafts.forEach(function(draft) { %>

            <%
              let statusClass = "status-pending";

              if (draft.status === "accepted_by_stro") {
                statusClass = "status-accepted";
              }

              if (draft.status === "rejected_by_stro") {
                statusClass = "status-rejected";
              }
            %>

            <tr>
              <td>
                <strong>
                  <%= draft.str_reference_number || `STR-${draft.str_id}` %>
                </strong>
              </td>

              <td>
                <%= draft.transaction_id || "N/A" %>
              </td>

              <td>
                <%= draft.merchant_name || draft.merchant_id || "N/A" %>
              </td>

              <td>
                <% if (draft.amount !== null && draft.amount !== undefined) { %>
                  <%= draft.currency || "SGD" %>
                  <%= Number(draft.amount).toFixed(2) %>
                <% } else { %>
                  N/A
                <% } %>
              </td>

              <td>
                <%= draft.risk_level || "N/A" %>
                (<%= draft.risk_score ?? "N/A" %>)
              </td>

              <td>
                <span class="badge <%= statusClass %>">
                  <%= draft.status.replaceAll("_", " ") %>
                </span>
              </td>

              <td>
                <a
                  href="/stro/drafts/<%= draft.str_id %>"
                  class="btn btn-sm btn-primary"
                >
                  View Draft
                </a>
              </td>
            </tr>

          <% }); %>

        </tbody>
      </table>

    </div>
  </div>
</div>

</body>
</html>