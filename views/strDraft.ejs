<!DOCTYPE html>
<html>
<head>
  <title>STR Draft</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">
<div class="container mt-5">

  <div class="card shadow">
    <div class="card-header bg-danger text-white">
      <h4>Suspicious Transaction Report Draft</h4>
    </div>

    <div class="card-body">
      <p><strong>STR Reference:</strong> <%= str.str_reference_number %></p>
      <p><strong>Status:</strong> <%= str.status %></p>
      <p><strong>Generated By:</strong> <%= str.generated_by %></p>
      <p><strong>Generated At:</strong> <%= str.generated_at %></p>

      <hr>

      <p><strong>Transaction ID:</strong> <%= str.transaction_id %></p>
      <p><strong>Merchant ID:</strong> <%= str.merchant_id %></p>
      <p><strong>Risk Level:</strong> <%= str.risk_level %></p>
      <p><strong>Risk Score:</strong> <%= str.risk_score %></p>
      <p><strong>Triggered Rules:</strong> <%= str.triggered_rules %></p>

      <hr>

      <h5>Narrative Text</h5>
      <pre style="white-space: pre-wrap;"><%= str.narrative_text %></pre>

      <a href="/api/officer/alerts" class="btn btn-secondary">Back</a>
      <button onclick="window.print()" class="btn btn-primary">Print / Save PDF</button>
    </div>
  </div>

</div>
</body>
</html>