<!DOCTYPE html>
<html>
<head>

  <title>Action Completed</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />

  <style>

    body{
      background:#f4f6f9;
    }

    .success-card{
      background:white;
      border-radius:14px;
      padding:40px;
      box-shadow:0 2px 12px rgba(0,0,0,0.08);
      text-align:center;
    }

  </style>

</head>

<body>

<div class="container mt-5">

  <div class="row justify-content-center">

    <div class="col-md-8">

      <div class="success-card">

        <% if(action === 'dismiss'){ %>

          <h1 class="text-secondary mb-4">
            Alert Dismissed
          </h1>

          <p class="fs-5">
            Alert ID <strong><%= alertId %></strong>
            has been dismissed successfully.
          </p>

        <% } else if(action === 'escalate'){ %>

          <h1 class="text-danger mb-4">
            Alert Escalated
          </h1>

          <p class="fs-5">
            Alert ID <strong><%= alertId %></strong>
            has been escalated for further investigation.
          </p>

        <% } else { %>

          <h1 class="text-success mb-4">
            Alert Reviewed
          </h1>

        <% } %>

        <div class="mt-5">

          <a
            href="/api/officer/alerts"
            class="btn btn-primary btn-lg"
          >
            Back to Alerts
          </a>

        </div>

      </div>

    </div>

  </div>

</div>

</body>
</html>