<!DOCTYPE html>
<html>
<head>

  <title>Action Completed</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />

  <style>

    body{
      background:#f4f6f9;
    }

    .success-card{
      background:white;
      border-radius:14px;
      padding:40px;
      box-shadow:0 2px 12px rgba(0,0,0,0.08);
      text-align:center;
    }

  </style>

</head>

<body>

<div class="container mt-5">

  <div class="row justify-content-center">

    <div class="col-md-8">

      <div class="success-card">

        <% if(action === 'dismiss' || action === 'close_case'){ %>

          <h1 class="text-secondary mb-4">
            Case Closed
          </h1>

          <p class="fs-5">
            Alert ID <strong><%= alertId %></strong>
            has been closed successfully.
          </p>

        <% } else if(action === 'escalate' || action === 'escalate_to_stro'){ %>

          <h1 class="text-danger mb-4">
            Case Escalated to STRO
          </h1>

          <p class="fs-5">
            Alert ID <strong><%= alertId %></strong>
            has been escalated for further investigation.
          </p>

        <% } else { %>

          <h1 class="text-success mb-4">
            Alert Reviewed
          </h1>

        <% } %>

        <div class="mt-5 d-flex justify-content-center gap-3 flex-wrap">

          <a
            href="/api/officer/alerts/<%= alertId %>"
            class="btn btn-primary btn-lg"
          >
            View Alert Details
          </a>

          <a
            href="/dashboard.html"
            class="btn btn-outline-secondary btn-lg"
          >
            Back to Dashboard
          </a>

        </div>

      </div>

    </div>

  </div>

</div>

</body>
</html>
